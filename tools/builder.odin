package builder

import "core:fmt"
import "core:math/linalg"


D65     :: [2]f64{0.3127, 0.3290}
CIE_XYZ :: [3]f64

SRGB :: matrix[3, 3]f64{
	0.64, 0.33, 0.03,
	0.30, 0.60, 0.10,
	0.15, 0.06, 0.79,
}

DISPLAY_P3 :: matrix[3, 3]f64{
	0.680, 0.320, 0.000,
	0.265, 0.690, 0.045,
	0.150, 0.060, 0.790,
}

ADOBE_RGB :: matrix[3, 3]f64{
	0.6400, 0.3300, 0.0300,
	0.2100, 0.7100, 0.0800,
	0.1500, 0.0600, 0.7900,
}

BT2020 :: matrix[3, 3]f64{
	0.708, 0.292, 0.000,
	0.170, 0.797, 0.033,
	0.131, 0.046, 0.823,
}


Colour_Space :: enum(u8) {
	sRGB,
	Display_P3,
	Adobe_RGB,
	Rec2020,
}

@(rodata)
chromaticities: [Colour_Space]matrix[3, 3]f64 = {
	.sRGB       = SRGB,
	.Display_P3 = DISPLAY_P3,
	.Adobe_RGB  = ADOBE_RGB,
	.Rec2020    = BT2020,
}

@(rodata)
space_to_string: [Colour_Space]string = {
	.sRGB       = "SRGB",
	.Display_P3 = "DISPLAY_P3",
	.Adobe_RGB  = "ADOBE_RGB",
	.Rec2020    = "REC2020",
}

@(rodata) // NOTE: totally needless but I'm pedantic
space_to_doc_string: [Colour_Space]string = {
	.sRGB       = "sRGB",
	.Display_P3 = "Display P3",
	.Adobe_RGB  = "Adobe RGB",
	.Rec2020    = "Rec. 2020",
}


@(require_results)
rgb_to_xyz :: proc "contextless" (p: matrix[3, 3]f64) -> matrix[3, 3]f64 {
	r: CIE_XYZ = {p[0, 0], p[0, 1], p[0, 2]} / p[0, 1]
	g: CIE_XYZ = {p[1, 0], p[1, 1], p[1, 2]} / p[1, 1]
	b: CIE_XYZ = {p[2, 0], p[2, 1], p[2, 2]} / p[2, 1]

	m: matrix[3, 3]f64 = {
		r.x, g.x, b.x,
		r.y, g.y, b.y,
		r.z, g.z, b.z,
	}

	w: CIE_XYZ = CIE_XYZ{D65.x, D65.y, 1.0 - D65.x - D65.y} / D65.y
	s: CIE_XYZ = (linalg.inverse(m) * w)

	diag_s: matrix[3, 3]f64 = {
		s.x, 0,   0,
		0,   s.y, 0,
		0,   0,   s.z,
	}

	return (m * diag_s)
}

@(require_results)
rgb_to_lms :: proc "contextless" (m: matrix[3, 3]f64) -> matrix[3, 3]f64 {
	// XYZ -> linear LMS (cone response) matrix,
	// as defined by Björn Ottosson for the OKLab colour space
	XYZ_TO_LINEAR_LMS :: matrix[3, 3]f64{
		0.8189330101, 0.3618667424, -0.1288597137,
		0.0329845436, 0.9293118715,  0.0361456387,
		0.0482003018, 0.2643662691,  0.6338517070,
	}

	return (XYZ_TO_LINEAR_LMS * rgb_to_xyz(m))
}

emit :: proc(name: string, m: matrix[3, 3]f32) {
	fmt.println(name, ":: matrix[3, 3]f32{")
	for row in 0..<3 do fmt.printfln("\t%.10f, %.10f, %.10f,", m[row, 0], m[row, 1], m[row, 2])
	fmt.println("}\n")
}


main :: proc() {
	lms: [Colour_Space]matrix[3, 3]f64
	for space in Colour_Space {
		lms[space] = rgb_to_lms(chromaticities[space])
	}

	for space in Colour_Space {
		name: string = space_to_string[space]

		fmt.printfln("// The products of XYZ <-> %s and XYZ <-> LMS matrices", space_to_doc_string[space])
		fmt.println("// GENERATED BY THE BUILDER TOOL; DO NOT EDIT BY HAND.\n")
		emit(fmt.tprintf("LINEAR_LMS_TO_LINEAR_%s", name), cast(matrix[3, 3]f32)linalg.inverse(lms[space]))
		emit(fmt.tprintf("LINEAR_%s_TO_LINEAR_LMS", name), cast(matrix[3, 3]f32)lms[space])
	}

	for a in Colour_Space {
		for b in Colour_Space {
			if a >= b do continue

			name_a, name_b: string = space_to_string[a], space_to_string[b]
			fmt.printfln("// Products of XYZ <-> %s and XYZ <-> %s matrices.", space_to_doc_string[a], space_to_doc_string[b])
			fmt.println("// GENERATED BY THE BUILDER TOOL; DO NOT EDIT BY HAND.\n")
			emit(fmt.tprintf("LINEAR_%s_TO_LINEAR_%s", name_a, name_b), cast(matrix[3, 3]f32)linalg.inverse(lms[b]) * lms[a])
			emit(fmt.tprintf("LINEAR_%s_TO_LINEAR_%s", name_b, name_a), cast(matrix[3, 3]f32)linalg.inverse(linalg.inverse(lms[b]) * lms[a]))
		}
	}
}
